template <class T, int C, int R> struct matrix {
  vec<T, R> columns[C];
  matrix() = default;
  template <class S, class = __xef_scalar_t<S>> XEF_CINL explicit matrix(S d) : columns{} {
    for (int c = 0; c < C; c++) for (int r = 0; r < R; r++) columns[c][r] = (c == r) ? (T)d : (T)0;
  }
  template <class... A, class = typename __xef_enable_if_t<sizeof...(A) + 1 == C>::type>
  XEF_CINL matrix(vec<T, R> c0, A... rest) : columns{c0, vec<T, R>(rest)...} {}
  template <class... A, class = typename __xef_enable_if_t<sizeof...(A) == C * R && (C * R > C)>::type, class = void>
  XEF_CINL matrix(A... s) : columns{} {
    T t[C * R] = {(T)s...};
    for (int c = 0; c < C; c++) for (int r = 0; r < R; r++) columns[c][r] = t[c * R + r];
  }
  template <class U> XEF_CINL explicit matrix(const matrix<U, C, R>& o) : columns{} {
    for (int c = 0; c < C; c++) columns[c] = vec<T, R>(o.columns[c]);
  }
  XEF_INL vec<T, R>& operator[](int c) { return columns[c]; }
  XEF_CINL vec<T, R> operator[](int c) const { return columns[c]; }
  template <class U> XEF_INL matrix& operator*=(U b) { *this = *this * b; return *this; }
  template <class U> XEF_INL matrix& operator+=(U b) { *this = *this + b; return *this; }
  template <class U> XEF_INL matrix& operator-=(U b) { *this = *this - b; return *this; }
};
template <class T, int C, int R> XEF_CINL vec<T, R> operator*(const matrix<T, C, R>& m, vec<T, C> v) {
  vec<T, R> r = m.columns[0] * v[0];
  for (int c = 1; c < C; c++) r = r + m.columns[c] * v[c];
  return r;
}
template <class T, int C, int R> XEF_CINL vec<T, C> operator*(vec<T, R> v, const matrix<T, C, R>& m) {
  vec<T, C> r;
  for (int c = 0; c < C; c++) { vec<T, R> p = m.columns[c] * v; T s = p[0]; for (int k = 1; k < R; k++) s += p[k]; r[c] = s; }
  return r;
}
template <class T, int K, int R, int C> XEF_CINL matrix<T, C, R> operator*(const matrix<T, K, R>& a, const matrix<T, C, K>& b) {
  matrix<T, C, R> r;
  for (int c = 0; c < C; c++) r.columns[c] = a * b.columns[c];
  return r;
}
template <class T, int C, int R, class S, class = __xef_scalar_t<S>> XEF_CINL matrix<T, C, R> operator*(const matrix<T, C, R>& a, S s) {
  matrix<T, C, R> r; for (int c = 0; c < C; c++) r.columns[c] = a.columns[c] * (T)s; return r;
}
template <class T, int C, int R, class S, class = __xef_scalar_t<S>> XEF_CINL matrix<T, C, R> operator*(S s, const matrix<T, C, R>& a) { return a * s; }
template <class T, int C, int R> XEF_CINL matrix<T, C, R> operator+(const matrix<T, C, R>& a, const matrix<T, C, R>& b) {
  matrix<T, C, R> r; for (int c = 0; c < C; c++) r.columns[c] = a.columns[c] + b.columns[c]; return r;
}
template <class T, int C, int R> XEF_CINL matrix<T, C, R> operator-(const matrix<T, C, R>& a, const matrix<T, C, R>& b) {
  matrix<T, C, R> r; for (int c = 0; c < C; c++) r.columns[c] = a.columns[c] - b.columns[c]; return r;
}
template <class T, int C, int R> XEF_CINL matrix<T, C, R> operator-(const matrix<T, C, R>& a) {
  matrix<T, C, R> r; for (int c = 0; c < C; c++) r.columns[c] = -a.columns[c]; return r;
}
template <class T, int C, int R> XEF_CINL matrix<T, R, C> transpose(const matrix<T, C, R>& m) {
  matrix<T, R, C> r; for (int c = 0; c < C; c++) for (int k = 0; k < R; k++) r.columns[k][c] = m.columns[c][k]; return r;
}
template <class T> XEF_CINL T determinant(const matrix<T, 2, 2>& m) { return m[0][0] * m[1][1] - m[1][0] * m[0][1]; }
template <class T> XEF_CINL T determinant(const matrix<T, 3, 3>& m) {
  return m[0][0] * (m[1][1] * m[2][2] - m[2][1] * m[1][2]) - m[1][0] * (m[0][1] * m[2][2] - m[2][1] * m[0][2]) +
         m[2][0] * (m[0][1] * m[1][2] - m[1][1] * m[0][2]);
}
template <class T> XEF_CINL T determinant(const matrix<T, 4, 4>& m) {
  T s = 0;
  for (int i = 0; i < 4; i++) {
    matrix<T, 3, 3> sub;
    for (int c = 1; c < 4; c++) { int rr = 0; for (int r = 0; r < 4; r++) if (r != i) sub.columns[c - 1][rr++] = m[c][r]; }
    T d = determinant(sub) * m[0][i];
    s += (i & 1) ? -d : d;
  }
  return s;
}

