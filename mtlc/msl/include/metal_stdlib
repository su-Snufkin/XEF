template <class T, access A = access::sample, memory_coherence __MC = memory_coherence_threadgroup> struct texture_buffer {
  __xef_tex_h h;
  XEF_CINL texture_buffer() : h(nullptr) {}
  XEF_CINL texture_buffer(__xef_tex_h x) : h(x) {}
  XEF_CINL bool __acc_rw() const { return A == access::read_write; }
  XEF_INL vec<T, 4> read(uint c) const { return vec<T, 4>::from(__xef_read_texture_buffer_sel<T>::call(h, (uint)c, __acc_rw() ? 3 : 1)); }
  XEF_INL void write(vec<T, 4> v, uint c) const { __xef_write_texture_buffer_sel<T>::call(h, (uint)c, v.v, __acc_rw() ? 3 : 2); }
  XEF_INL void write(T v, uint c) const { write(vec<T, 4>(v), c); }
  XEF_INL vec<T, 4> read(ushort c) const { return vec<T, 4>::from(__xef_read_texture_buffer_sel<T>::call(h, (uint)c, __acc_rw() ? 3 : 1)); }
  XEF_INL void write(vec<T, 4> v, ushort c) const { __xef_write_texture_buffer_sel<T>::call(h, (uint)c, v.v, __acc_rw() ? 3 : 2); }
  XEF_INL void write(T v, ushort c) const { write(vec<T, 4>(v), c); }
  XEF_INL uint get_width() const { return __xef_get_width_texture_buffer(h); }
  XEF_INL void fence() const {}
};

template <class T> XEF_INL bool is_null_texture(T t) { return t.h == nullptr; }
template <class T> XEF_INL bool is_null_sampler(T s) { return s.h == nullptr && s.state == 0; }

