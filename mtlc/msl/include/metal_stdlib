// ---------------- pack / unpack ----------------
XEF_INL uint pack_float_to_unorm4x8(float4 v) { uint4 c = uint4(saturate(v) * 255.0f + 0.5f); return c.x | (c.y << 8) | (c.z << 16) | (c.w << 24); }
XEF_INL uint pack_float_to_snorm4x8(float4 v) { int4 c = int4(round(clamp(v, -1.0f, 1.0f) * 127.0f)); return (uint)(c.x & 255) | ((uint)(c.y & 255) << 8) | ((uint)(c.z & 255) << 16) | ((uint)(c.w & 255) << 24); }
XEF_INL uint pack_float_to_unorm2x16(float2 v) { uint2 c = uint2(saturate(v) * 65535.0f + 0.5f); return c.x | (c.y << 16); }
XEF_INL uint pack_float_to_snorm2x16(float2 v) { int2 c = int2(round(clamp(v, -1.0f, 1.0f) * 32767.0f)); return (uint)(c.x & 65535) | ((uint)(c.y & 65535) << 16); }
XEF_INL float4 unpack_unorm4x8_to_float(uint x) { return float4(uint4(x & 255, (x >> 8) & 255, (x >> 16) & 255, x >> 24)) / 255.0f; }
XEF_INL half4 unpack_unorm4x8_to_half(uint x) { return half4(unpack_unorm4x8_to_float(x)); }
XEF_INL float4 unpack_snorm4x8_to_float(uint x) { int4 c = int4((int)(x << 24) >> 24, (int)(x << 16) >> 24, (int)(x << 8) >> 24, (int)x >> 24); return fmax(float4(c) / 127.0f, -1.0f); }
XEF_INL float2 unpack_unorm2x16_to_float(uint x) { return float2(uint2(x & 65535, x >> 16)) / 65535.0f; }
XEF_INL float2 unpack_snorm2x16_to_float(uint x) { int2 c = int2((int)(x << 16) >> 16, (int)x >> 16); return fmax(float2(c) / 32767.0f, -1.0f); }
XEF_INL uint pack_half_to_unorm4x8(half4 v) { return pack_float_to_unorm4x8(float4(v)); }
XEF_INL ushort pack_float_to_unorm2x8(float2 v) { uint2 c = uint2(saturate(v) * 255.0f + 0.5f); return (ushort)(c.x | (c.y << 8)); }
XEF_INL float2 unpack_unorm2x8_to_float(ushort x) { return float2(uint2(x & 255, x >> 8)) / 255.0f; }
XEF_INL float4 unpack_unorm10a2_to_float(uint x) { return float4((float)(x & 1023) / 1023.0f, (float)((x >> 10) & 1023) / 1023.0f, (float)((x >> 20) & 1023) / 1023.0f, (float)(x >> 30) / 3.0f); }
XEF_INL float3 unpack_unorm565_to_float(ushort x) { return float3((float)(x & 31) / 31.0f, (float)((x >> 5) & 63) / 63.0f, (float)(x >> 11) / 31.0f); }

